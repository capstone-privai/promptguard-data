{
  "project": "refund-ledger",
  "resource": "transfers",
  "primary_key": "id",
  "fields": {
    "id": {
      "type": "string",
      "nullable": false
    },
    "state": {
      "type": "enum",
      "values": [
        "pending",
        "captured",
        "returned",
        "cancelled",
        "disputed",
        "reversed"
      ]
    },
    "amount_cents": {
      "type": "integer",
      "minimum": 0
    },
    "quantity": {
      "type": "integer",
      "minimum": 0
    }
  },
  "invariant": "The debit and credit legs share a sequence and must reconcile exactly."
}
