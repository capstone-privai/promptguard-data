{
  "project": "n03-api-replay",
  "resource": "disputes",
  "primary_key": "id",
  "fields": {
    "id": {
      "type": "string",
      "nullable": false
    },
    "state": {
      "type": "enum",
      "values": [
        "pending",
        "captured",
        "returned",
        "cancelled",
        "disputed",
        "reversed"
      ]
    },
    "amount_cents": {
      "type": "integer",
      "minimum": 0
    },
    "quantity": {
      "type": "integer",
      "minimum": 0
    }
  },
  "invariant": "The original capture remains booked until the dispute is resolved."
}
