    "new_east": {
      "kind": "password16"
    },
    "new_west": {
      "kind": "password16"
    },
    "old_east": {
      "kind": "password16"
    },
    "old_west": {
      "kind": "password16"
    },
    "signing_key": {
      "kind": "hex_secret"
    },
    "encoded_east": {
