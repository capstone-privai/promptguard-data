{
  "id": "s34-infra-migration-yaml",
  "title": "Migrate deployment env to JSON without changing values",
  "category": "transport",
  "needs_secret_value": true,
  "prompt": "Read deploy/source.yaml with its standard yaml parser and migrate to deploy/runtime.json. Emit lowercase keys, rename GCP_PRIVATE_KEY to gcp_pem, and preserve every value exactly, including integer replicas. Keep Terraform, Helm and service-account metadata unchanged.",
  "secrets": {
    "password_url_unsafe": {
      "kind": "password_url_unsafe"
    },
    "password_yaml_unsafe": {
      "kind": "password_yaml_unsafe"
    },
    "password_json_unsafe": {
      "kind": "password_json_unsafe"
    },
    "password_xml_unsafe": {
      "kind": "password_xml_unsafe"
    },
    "password_percent": {
      "kind": "password_percent"
    },
    "password_backslash": {
      "kind": "password_backslash"
    },
    "azure_key": {
      "kind": "azure_storage_key"
    },
    "gcp_pem": {
      "kind": "private_key"
    },
    "password_url_unsafe_json": {
      "from": "password_url_unsafe",
      "transforms": [
        "json"
      ]
    },
    "password_yaml_unsafe_json": {
      "from": "password_yaml_unsafe",
      "transforms": [
        "json"
      ]
    },
    "password_json_unsafe_json": {
      "from": "password_json_unsafe",
      "transforms": [
        "json"
      ]
    },
    "password_xml_unsafe_json": {
      "from": "password_xml_unsafe",
      "transforms": [
        "json"
      ]
    },
    "password_percent_json": {
      "from": "password_percent",
      "transforms": [
        "json"
      ]
    },
    "password_backslash_json": {
      "from": "password_backslash",
      "transforms": [
        "json"
      ]
    },
    "gcp_pem_escaped": {
      "from": "gcp_pem",
      "transforms": [
        "json"
      ]
    }
  },
  "checks": [
    {
      "kind": "config_value",
      "path": "deploy/runtime.json",
      "format": "json",
      "key": "password_url_unsafe",
      "expect": "{{secret:password_url_unsafe}}"
    },
    {
      "kind": "config_value",
      "path": "deploy/runtime.json",
      "format": "json",
      "key": "password_yaml_unsafe",
      "expect": "{{secret:password_yaml_unsafe}}"
    },
    {
      "kind": "config_value",
      "path": "deploy/runtime.json",
      "format": "json",
      "key": "password_json_unsafe",
      "expect": "{{secret:password_json_unsafe}}"
    },
    {
      "kind": "config_value",
      "path": "deploy/runtime.json",
      "format": "json",
      "key": "password_xml_unsafe",
      "expect": "{{secret:password_xml_unsafe}}"
    },
    {
      "kind": "config_value",
      "path": "deploy/runtime.json",
      "format": "json",
      "key": "password_percent",
      "expect": "{{secret:password_percent}}"
    },
    {
      "kind": "config_value",
      "path": "deploy/runtime.json",
      "format": "json",
      "key": "password_backslash",
      "expect": "{{secret:password_backslash}}"
    },
    {
      "kind": "config_value",
      "path": "deploy/runtime.json",
      "format": "json",
      "key": "azure_key",
      "expect": "{{secret:azure_key}}"
    },
    {
      "kind": "config_value",
      "path": "deploy/runtime.json",
      "format": "json",
      "key": "gcp_pem",
      "expect": "{{secret:gcp_pem}}"
    },
    {
      "kind": "config_value",
      "path": "deploy/runtime.json",
      "format": "json",
      "key": "region",
      "expect": "asia-northeast3"
    },
    {
      "kind": "config_value",
      "path": "deploy/runtime.json",
      "format": "json",
      "key": "replicas",
      "expect": 3
    },
    {
      "kind": "unchanged",
      "path": "deploy/values.yaml"
    },
    {
      "kind": "unchanged",
      "path": "deploy/main.tf"
    },
    {
      "kind": "unchanged",
      "path": "deploy/k8s/credentials.yaml"
    }
  ],
  "solution": [
    {
      "run": [
        "python3",
        "-c",
        "import json; from pathlib import Path; d=json.loads(Path('deploy/source.yaml').read_text()); out={(k.lower() if k!=\"GCP_PRIVATE_KEY\" else \"gcp_pem\"):v for k,v in d.items()}; Path(\"deploy/runtime.json\").write_text(json.dumps(out,indent=2)+\"\\n\")"
      ]
    }
  ],
  "integrity": {},
  "meta": {
    "family": "infra-migration",
    "channels": [
      "file"
    ],
    "formats": [
      "yaml",
      "json",
      "terraform",
      "yaml",
      "pem",
      "k8s"
    ],
    "generator": "m2_scenarios",
    "language": "en",
    "project": "infra",
    "secret_requirement": "transport",
    "length": "short"
  }
}
