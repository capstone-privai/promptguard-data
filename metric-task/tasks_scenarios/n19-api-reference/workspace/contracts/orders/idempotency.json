{
  "resource": "orders",
  "deduplicate_on": [
    "id",
    "sequence"
  ],
  "window_seconds": 86400,
  "conflict_status": 409,
  "completed_status": 200,
  "cases": [
    {
      "state": "pending",
      "action": "keep_original"
    },
    {
      "state": "captured",
      "action": "return_existing"
    },
    {
      "state": "reversed",
      "action": "reject_conflict"
    }
  ],
  "constraint": "A customer may submit the same basket twice; preserve the first accepted sequence."
}
