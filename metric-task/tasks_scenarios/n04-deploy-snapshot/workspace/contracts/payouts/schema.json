{
  "project": "n04-deploy-snapshot",
  "resource": "payouts",
  "primary_key": "id",
  "fields": {
    "id": {
      "type": "string",
      "nullable": false
    },
    "state": {
      "type": "enum",
      "values": [
        "pending",
        "captured",
        "returned",
        "cancelled",
        "disputed",
        "reversed"
      ]
    },
    "amount_cents": {
      "type": "integer",
      "minimum": 0
    },
    "quantity": {
      "type": "integer",
      "minimum": 0
    }
  },
  "invariant": "A bank rejection restores the pending payout without duplicating a movement."
}
