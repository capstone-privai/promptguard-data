{
  "project": "n04-deploy-snapshot",
  "resource": "settlements",
  "primary_key": "id",
  "fields": {
    "id": {
      "type": "string",
      "nullable": false
    },
    "state": {
      "type": "enum",
      "values": [
        "pending",
        "captured",
        "returned",
        "cancelled",
        "disputed",
        "reversed"
      ]
    },
    "amount_cents": {
      "type": "integer",
      "minimum": 0
    },
    "quantity": {
      "type": "integer",
      "minimum": 0
    }
  },
  "invariant": "Settlement groups close only when every provider movement has arrived."
}
