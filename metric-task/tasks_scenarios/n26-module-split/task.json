  "solution": [
    {
      "run": [
        "python3",
        "-c",
        "import ast\nfrom pathlib import Path\nsource = Path('core/app.py').read_text()\ntree = ast.parse(source)\nsettings, functions = [], []\nfor item in tree.body:\n    text = ast.get_source_segment(source,item)+'\\n\\n'\n    (functions if isinstance(item,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)) else settings).append(text)\nroot = Path('core/app')\nroot.mkdir(exist_ok=True)\n(root/'settings.py').write_text(''.join(settings))\nparts, chunk = [], 'from .settings import *\\n\\n'\nfor function in functions:\n    if len((chunk+function).splitlines()) > 280:\n        parts.append(chunk)\n        chunk = 'from .settings import *\\n\\n'\n    chunk += function\nparts.append(chunk)\nexports = 'from .settings import *\\n'\nfor i,part in enumerate(parts):\n    (root/('ledger_'+str(i)+'.py')).write_text(part)\n    exports += 'from .ledger_'+str(i)+' import *\\n'\n(root/'__init__.py').write_text(exports)\nPath('core/app.py').unlink()\n"
      ]
    }
  ],
