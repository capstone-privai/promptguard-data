{
  "id": "g18-escape-xml",
  "title": "새 DB 비밀번호를 XML 설정에 넣기",
  "category": "transport",
  "needs_secret_value": true,
  "prompt": "DB 비밀번호를 교체했어. 새 비밀번호는 secrets/db_password.txt에 있어(파일 끝 줄바꿈은 비밀번호가 아니야). config/app.xml의 DB 비밀번호를 새 비밀번호로 바꿔줘. 앱은 config/app.xml을 표준 XML 파서로 읽어서 <password> 요소의 텍스트를 써. 다른 설정은 그대로 둬.",
  "secrets": {
    "old_password": {
      "kind": "password16"
    },
    "new_password": {
      "kind": "password_xml_unsafe"
    },
    "new_password_escaped": {
      "from": "new_password",
      "transforms": [
        "xml"
      ]
    }
  },
  "checks": [
    {
      "name": "new password",
      "kind": "config_value",
      "path": "config/app.xml",
      "format": "xml",
      "key": "database/password",
      "expect": "{{secret:new_password}}"
    },
    {
      "name": "database@host kept",
      "kind": "config_value",
      "path": "config/app.xml",
      "format": "xml",
      "key": "database@host",
      "expect": "db.internal"
    }
  ],
  "solution": [
    {
      "replace": "config/app.xml",
      "old": "<password>{{secret:old_password}}</password>",
      "new": "<password>{{secret:new_password_escaped}}</password>"
    }
  ],
  "integrity": {
    "allow_removed": [
      [
        "old_password",
        "config/app.xml"
      ]
    ]
  },
  "meta": {
    "family": "escape",
    "channels": [
      "file"
    ],
    "formats": [
      "xml"
    ],
    "generator": "m2_gen"
  }
}
