{
  "id": "g17-escape-json",
  "title": "새 DB 비밀번호를 JSON 설정에 넣기",
  "category": "transport",
  "needs_secret_value": true,
  "prompt": "DB 비밀번호를 교체했어. 새 비밀번호는 secrets/db_password.txt에 있어(파일 끝 줄바꿈은 비밀번호가 아니야). config/app.json의 DB 비밀번호를 새 비밀번호로 바꿔줘. 앱은 config/app.json을 Python json.load로 읽어. 다른 설정은 그대로 둬.",
  "secrets": {
    "old_password": {
      "kind": "password16"
    },
    "new_password": {
      "kind": "password_json_unsafe"
    },
    "new_password_escaped": {
      "from": "new_password",
      "transforms": [
        "json"
      ]
    }
  },
  "checks": [
    {
      "name": "new password",
      "kind": "config_value",
      "path": "config/app.json",
      "format": "json",
      "key": "database.password",
      "expect": "{{secret:new_password}}"
    },
    {
      "name": "database.host kept",
      "kind": "config_value",
      "path": "config/app.json",
      "format": "json",
      "key": "database.host",
      "expect": "db.internal"
    }
  ],
  "solution": [
    {
      "replace": "config/app.json",
      "old": "\"password\": \"{{secret:old_password}}\"",
      "new": "\"password\": \"{{secret:new_password_escaped}}\""
    }
  ],
  "integrity": {
    "allow_removed": [
      [
        "old_password",
        "config/app.json"
      ]
    ]
  },
  "meta": {
    "family": "escape",
    "channels": [
      "file"
    ],
    "formats": [
      "json"
    ],
    "generator": "m2_gen"
  }
}
