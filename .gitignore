__pycache__/
*.py[cod]
.venv/
.DS_Store
:memory:.ses
runs/
# metric-detection results hold secret values (per_edit.jsonl, review worksheets); only the batch summaries
# (metrics and run folder names) are kept in git
metric-detection/results/**
!metric-detection/results/**/
!metric-detection/results/**/summary.csv
!metric-detection/results/**/summary.md
.python-version
metric-detection/claude/
# CredData file contents stay under their source repos' licenses (CredData itself ships only
# metadata); regenerate with metric-detection/scripts/convert_creddata.py
metric-detection/**/*_from_CredData.jsonl
# privesc-llm-data conversion (~50MB); regenerate with metric-detection/scripts/convert_privesc.py
metric-detection/**/*_from_privesc-llm-data.jsonl
# Every metric-detection dataset is a build output. The synthetic sets hold fake credentials in real formats,
# which push protection rejects; regenerate them with metric-detection/scripts/dataset_build.py
metric-detection/data_test/
metric-detection/data_answer/
# Nemotron-PII, openhands-feedback, SWE-Gym and Nosey Parker conversions; regenerate with their convert_*.py
# (metric-detection/reviews/ holds the hand-made verdicts without values and stays in git)
metric-detection/**/*_from_Nemotron-PII.jsonl
metric-detection/**/*_from_openhands-feedback.jsonl
metric-detection/**/*_from_SWE-Gym.jsonl
metric-detection/**/*_from_noseyparker.jsonl
# ML training corpus (ml_train_build.py): fake credentials in real formats, like the synthetic sets above
metric-detection/**/labels_ml_*.jsonl
# Its export (ml_train_export.py): the folder handed to the model, and the evaluation side's labels and manifest
metric-detection/ml_handoff/
# builds kept out of data_test/, where train sessions would stop an evaluation (metric-detection/README.md 사용 용도)
metric-detection/ml_build/
metric-detection/**/labels_mleval_*.jsonl
metric-detection/**/manifest_mleval.json
# LLM responses as returned (ml_train_write.py): a rejected one may hold a literal secret the model wrote
metric-detection/templates/ml_train/raw/
# Cards are rebuilt byte for byte from card_config.toml (ml_train_cards.py); batches/ records the sha256 used
metric-detection/templates/ml_train/cards*.jsonl


# 비밀값 소스 파일
frame.csv
