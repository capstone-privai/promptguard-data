__pycache__/
*.py[cod]
.venv/
.DS_Store
:memory:.ses
runs/
.python-version
metric-1/claude/
# CredData file contents stay under their source repos' licenses (CredData itself ships only
# metadata); regenerate with metric-1/scripts/convert_creddata.py
metric-1/**/*_from_CredData.jsonl
# privesc-llm-data conversion (~50MB); regenerate with metric-1/scripts/convert_privesc.py
metric-1/**/*_from_privesc-llm-data.jsonl
# Every metric 1 dataset is a build output. The synthetic sets hold fake credentials in real formats,
# which push protection rejects; regenerate them with metric-1/scripts/dataset_build.py
metric-1/data_test/
metric-1/data_answer/
# Nemotron-PII, openhands-feedback, SWE-Gym and Nosey Parker conversions; regenerate with their convert_*.py
# (metric-1/reviews/ holds the hand-made verdicts without values and stays in git)
metric-1/**/*_from_Nemotron-PII.jsonl
metric-1/**/*_from_openhands-feedback.jsonl
metric-1/**/*_from_SWE-Gym.jsonl
metric-1/**/*_from_noseyparker.jsonl
